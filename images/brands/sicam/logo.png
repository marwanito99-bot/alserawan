<style id="bridge-style-dynamic-responsive-inline-css">
svg{width:100%;}

.content .container .container_inner.page_container_inner, .full_page_container_inner {
    padding: 0px 0 0;
}

/* MENU*/
li#nav-menu-item-30 .second span {
    display: none;
}
li#nav-menu-item-30  .vc_column_container>.vc_column-inner {
    padding: 0;
}
li#nav-menu-item-30 .second .inner .widget {
    padding: 0!important;
}
.drop_down .second .inner ul li {
    width: 17.8%!important;
    border: 0;
    display: inline-block!important;
    float: none;
}
li#nav-menu-item-30 .second ul {
    display: block;
    width: 1080px!important;
    height: 300px;
    left: -120px;
}
.drop_down .wide .second ul li .qbutton {
    border: 0;
    border-radius: 0;
    color: #fff;
    width: 184px;
    padding: 0;
    text-align: center;
    text-transform: none;
    box-shadow: inset 0px 0px 0px #c02319;
    transition: 0.3s ease-in;
}
.drop_down .wide .second ul li .qbutton:hover {
    box-shadow: inset 200px 0px 0px #c02319;
}
span.plus_label {
    color: #000;
    position: absolute;
    margin-left: 5px;
    font-size: 1.4rem;
    margin-top: 0px;
}
span.plus_label_en {
    color: #000;
    position: absolute;
    margin-left: 5px;
    font-size: 1.4rem;
    margin-top: 0px;
}
span.plus_label_es {
    color: #000;
    position: absolute;
    margin-left: 5px;
    font-size: 1.4rem;
    margin-top: 0px;
}
span.plus_label_fr {
    color: #000;
    position: absolute;
    margin-left: 5px;
    font-size: 1.4rem;
    margin-top: 0px;
}
li#nav-menu-item-30:hover span.plus_label {
    color: #c02319;
}
li#nav-menu-item-1171:hover span.plus_label_en {
    color: #c02319;
}
li#nav-menu-item-1371:hover span.plus_label_es {
    color: #c02319;
}
li#nav-menu-item-1557:hover span.plus_label_es {
    color: #c02319;
}
li#nav-menu-item-33 a {
    padding: 0 17px 0 25px;
}
li#nav-menu-item-1157 a {
    padding: 0 17px 0 25px;
}
li#nav-menu-item-1543 a {
    padding: 0 17px 0 25px;
}
@media (max-width: 1112px) {
    nav.main_menu > ul > li > a {
        padding: 0 10px;
        font-size: 15px;
    }
}

/* FINE MENU */

.thelibrary img {
    position: relative;
    top: 4px;
}
/* SELETTORE LINGUA */

.wpml-ls-legacy-dropdown {
    width: 15.5em;
    max-width: 65px;
}

.wpml-ls-legacy-dropdown a {
    border: none;
    line-height: 1.7;
}

.wpml-ls-legacy-dropdown .wpml-ls-sub-menu {
    border-top: none;
}

/* FINE SELETTORE LINGUA */

/*BOTTONI*/
.qbutton, .qbutton.medium, #submit_comment, .load_more a, .blog_load_more_button a, .post-password-form input[type='submit'], input.wpcf7-form-control.wpcf7-submit,  .woocommerce table.cart td.actions input[type="submit"], .woocommerce input#place_order, .woocommerce-page input[type="submit"], .woocommerce .button {
    padding-top: 15px;
    padding-bottom: 15px;
    box-shadow: inset 0 0 0 0 #c02319;
    -webkit-transition: ease-out 0.4s;
    -moz-transition: ease-out 0.4s;
    transition: ease-out 0.4s;
}
.qbutton:hover, .qbutton.medium:hover, #submit_comment:hover, .load_more a:hover, .blog_load_more_button a:hover, .post-password-form input[type='submit']:hover,  .woocommerce table.cart td.actions input[type="submit"]:hover, .woocommerce input#place_order:hover, .woocommerce-page input[type="submit"]:hover, .woocommerce .button:hover {
    box-shadow: inset 400px 0 0 0 #c02319;
}

input.wpcf7-form-control.wpcf7-submit, input.wpcf7-form-control.wpcf7-submit:not([disabled]), .qbutton.white {
    padding-top: 15px;
    padding-bottom: 15px;
    box-shadow: inset 0 0 0 0 #000;
    -webkit-transition: ease-out 0.4s;
    -moz-transition: ease-out 0.4s;
    transition: ease-out 0.4s;
    background-color: #c02319;
    color: #fff;
}
input.wpcf7-form-control.wpcf7-submit:not([disabled]):hover, .qbutton.white:hover {
    box-shadow: inset 400px 0 0 0 #000;
    color: #fff;
}
@media (max-width: 768px) {
    a.qbutton.default {
        padding-top: 10px;
        padding-bottom: 10px;
    }
}
/*FINE BOTTONI*/

h1.titolo-absolute {
    font-size: 162px;
    position: absolute;
    top: -250px;
    left: -10px;
    z-index: -1;
    font-weight: 700;
    -webkit-text-fill-color: transparent;
    -webkit-text-stroke-width: 2px;
    -webkit-text-stroke-color: #b0b0b0;
}
.menu_button a {
    padding: 0!important;
}
.mobile_menu_button {
    float: right;
    margin: 0 0 0 20px;
}
.mobile_menu_button span {
    color: #c02519;
    font-size: 3rem;
}
@media (max-width: 1000px) {
    .logo_wrapper {
        left: 10%;
    }
}
@media (max-width: 480px) {
    .logo_wrapper {
        left: 25%;
    }
}
/*singolo articolo*/
.post_content_holder img.attachment-full.size-full.wp-post-image {
    width: auto;
}
.post_content_holder h2.entry_title {
    font-size: 2rem;
    line-height: 2.5rem;
}
.post_content_holder .post_info {
    visibility: hidden;
}
.post_content_holder {
    margin: 50px 0;
}

@media (max-width: 1079px) {
    li#nav-menu-item-30 .second ul {
        width: 1024px!important;
        left: -118px;
    }
    .drop_down .second .inner ul li {
        width: 16.8%!important;
    }
    .drop_down .wide .second ul li .qbutton {
        width: 168px;
    }
}

.qode-search-results-three-columns h2.entry_title a {
    font-size: 1.6rem;
    line-height: 0rem;
}
.qode-search-results-three-columns span.date.entry_date.updated {
    font-size: 1.2rem;
}

/*cookie_policy_consent*/
div#cookie-notice {
    background-color: transparent!important;
}
span#cn-notice-text:before {
    content: url(https://www.sicam.it/wp-content/uploads/2020/03/logo_sicam.png);
    display: block;
    margin-bottom: 10px;
}
#cookie-notice .cookie-notice-container {
    display: block;
    width: fit-content!important;
    margin: 80px auto;
    padding: 70px 40px;
    background-color: #fff;
    box-shadow: 15px 15px 0px rgba(0,0,0,0.4);
    border: 1px solid #000;
}
span#cn-notice-text {
    font-size: 1rem;
    display: block;
    margin-bottom: 1%;
    text-align: left;
}
span#cn-notice-buttons {
    display: block;
    float: right;
}
.cn-button.bootstrap {
    background: #000;
}

/*megamenu*/
nav.main_menu.drop_down.right {
    width: 100%!important;
}
#mega-menu-item-30 a.mega-menu-link {
    padding-right: 20px!important;
}
#mega-menu-item-1371 a.mega-menu-link {
    padding-right: 20px!important;
}
#mega-menu-item-1171 a.mega-menu-link {
    padding-right: 20px!important;
}
#mega-menu-item-1557 a.mega-menu-link {
    padding-right: 20px!important;
}
#mega-menu-item-1157 a.mega-menu-link {
    padding-left: 20px!important;
}
#mega-menu-item-1358 a.mega-menu-link {
    padding-left: 20px!important;
}
#mega-menu-item-1543 a.mega-menu-link {
    padding-left: 20px!important;
}
.header_inner_left {
    z-index: 99999;
}
a.qbutton.center.default.bottone_menu {
    display: block;
    margin: 0 auto!important;
    position: relative;
    height: auto;
    font-size: 14px;
    line-height: 35px;
    width: 83.5%;
    height: 36px;
    text-align: center;
}
.mega-menu-item .textwidget.custom-html-widget {
    margin-top: -43px;
    position: absolute;
    width: 100%;
}
.mega-menu-item.widget_media_image a {
    line-height: 0px;
}
@media (max-width: 1024px) {
     h1.titolo-absolute {
          top: -210px;
     }
     #mega-menu-wrap-top-navigation #mega-menu-top-navigation > li.mega-menu-item > a.mega-menu-link {
          padding: 0 9px;
     }
}
span.date.entry_date.updated {
    display: none;
}
header.has_top.scroll_top.stick.scrolled_not_transparent.with_border.page_header.sticky.sticky_animate .q_logo img {
    top: -20%;
}

.left .textwidget.custom-html-widget a {
    color: #c02419;
    font-weight: 500;
    -webkit-font-smoothing: antialiased;
    transition: all 0.3s ease-in-out;
}
.left .textwidget.custom-html-widget a:hover {
    text-decoration: underline;
}

a.qbutton.default.brochure {
    padding-left: 20px;
    padding-right: 20px;
    margin: 0 auto;
    display: block;
    text-align: center;
    font-size: 0.9rem;
}
a.qbutton.default.brochure:before {
    content: '\f1c1';
    font-family: FontAwesome;
    margin-right: 10px;
}

img.img-infoscheda {
    max-width: 148px!important;
}

/*BUG FIX Search*/
.header-widget.widget_search.header-left-widget {
    display: flex;
}
form#searchform {
    margin-left: -50px;
    background: #fff;
}



span.wpcf7-form-control.wpcf7-acceptance {
    display: none;
}
.fake_accept {
    width: 20px;
    height: 20px;
    display: flex;
    border: 1px solid #999999;
    justify-content: center;
    align-items: center;
    margin-right: 10px !important;
}
.fake_accept:after {
    content: '\f00c';
    font-family: Fontawesome;
    color: #c02419;
    opacity: 0;
    transition: all 0.2s ease;
}
.fake_accept.active:after {
    opacity: 1;
}
/*# sourceURL=bridge-style-dynamic-responsive-inline-css */
</style>
